# Nexus Engine Environment Configuration
# Copy this file to .env and insert your credentials.
# All other architectural settings and defaults are managed in constants.py and config.py.

# Server Hosts & Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8766
FRONTEND_PORT=5200

# Server & CORS Origins (comma-separated allowed origins)
DEFAULT_CORS_ORIGINS=http://127.0.0.1:5200,http://localhost:5200,http://127.0.0.1:5199,http://localhost:5199

# Database & Audit Paths
DEFAULT_AUDIT_DB_PATH=data/db/audit.db
DEFAULT_DATABASE_PATH=data/db/nexus.db

# Primary LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_LLM_API_KEY=your_gemini_llm_api_key_here

# Embedding Subsystem (gemini for Google text-embedding-004, or remote/mock)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_API_KEY=your_gemini_embedding_api_key_here

# Authentication. Unset ENV means production.
# Open mode (no API_KEY) is allowed ONLY with ENV=development and a loopback BACKEND_HOST.
# ENV=development
# API_KEY=
# PBKDF2 hashes (pbkdf2_sha256$iters$salt$hash, >= 600000 iterations). Generate with:
#   python -m backend.app.services.security.bootstrap --role admin
# Keep the value single-quoted: it contains '$'. ADMIN_PASSWORD_HASH is required outside development.
# ADMIN_PASSWORD_HASH=
# OPERATOR_PASSWORD_HASH=
# AUDITOR_PASSWORD_HASH=

# Code-execution sandbox. DISABLED by default. When true, only users with the admin role can run code, and only
# code they typed in their own message. See docs/sandbox.md for what the isolation does and does not guarantee.
# SANDBOX_ENABLED=false
# SANDBOX_TIMEOUT_S=5.0
# SANDBOX_MEMORY_MB=256
# SANDBOX_MAX_CONCURRENT=2

# Langfuse Observability & Tracing (optional, leave unset for local fallback)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
